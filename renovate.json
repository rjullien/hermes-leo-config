{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:base"],
  "customDatasources": {
    "devin-cli": {
      "description": "Devin CLI : version lue depuis le manifest officiel static.devin.ai",
      "defaultRegistryUrlTemplate": "https://static.devin.ai/cli/current/manifest.json",
      "format": "json",
      "transformTemplates": [
        "{'releases': [{'version': version}]}"
      ]
    }
  },
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["^Dockerfile$"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)\\nARG \\w+=(?<currentValue>[^\\s]+)\\nARG \\w+_SHA256=(?<currentDigest>[a-f0-9]{64})"
      ],
      "extractVersionTemplate": "^v?(?<version>.*)$"
    }
  ],
  "packageRules": [
    {
      "description": "Image de base hermes-agent : calver vYYYY.M.D — délai 7j (sécurité), AUTOMERGE (review humaine = renovate vps-infra)",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["nousresearch/hermes-agent"],
      "versioning": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(?:\\.(?<build>\\d+))?$",
      "minimumReleaseAge": "7 days",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Binaires outils (gws, gh, kubectl, devin, go) : releases officielles — délai 3j, AUTOMERGE",
      "matchPackageNames": ["googleworkspace/cli", "cli/cli", "kubernetes/kubernetes", "devin-cli", "golang"],
      "minimumReleaseAge": "3 days",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "GitHub Actions du repo : automerge après checks",
      "matchDatasources": ["github-tags"],
      "matchManagers": ["github-actions"],
      "automerge": true,
      "automergeType": "pr"
    }
  ],
  "automerge": true,
  "automergeType": "pr",
  "requiredStatusChecks": [],
  "ignoreTests": true,
  "prBodyColumns": ["Package", "Update", "Type", "Change", "Notes"]
}