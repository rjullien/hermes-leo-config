{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:base"],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["^Dockerfile$"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)\\nARG \\w+=(?<currentValue>[^\\s]+)"
      ],
      "extractVersionTemplate": "^v?(?<version>.*)$"
    }
  ],
  "packageRules": [
    {
      "description": "Image de base hermes-agent : calver vYYYY.M.D — ignorer latest/main",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["nousresearch/hermes-agent"],
      "versioning": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(?:\\.(?<build>\\d+))?$",
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Binaires outils (gws, gh, kubectl) : releases officielles — délai court",
      "matchPackageNames": ["googleworkspace/cli", "cli/cli", "kubernetes/kubernetes"],
      "minimumReleaseAge": "3 days"
    }
  ]
}